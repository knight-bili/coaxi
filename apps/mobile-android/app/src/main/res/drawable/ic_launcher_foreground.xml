<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive-icon foreground: a "</>" code-bracket glyph, echoing the iOS app icon.
  Drawn as stroked paths inside the 108x108 viewport (safe zone ~ the centre 66dp).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Left chevron  <  -->
    <path
        android:strokeColor="#DCDFE9"
        android:strokeWidth="6"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000"
        android:pathData="M47,42 L34,54 L47,66" />

    <!-- Slash  /  -->
    <path
        android:strokeColor="#9FB0FF"
        android:strokeWidth="6"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M60,40 L48,68" />

    <!-- Right chevron  >  -->
    <path
        android:strokeColor="#DCDFE9"
        android:strokeWidth="6"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000"
        android:pathData="M61,42 L74,54 L61,66" />
</vector>
