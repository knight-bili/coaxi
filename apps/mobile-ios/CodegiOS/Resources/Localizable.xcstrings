          }
        }
      }
    },
    "只处理当前预览明确选择的条目；有后续修改会拒绝覆盖。历史任务保留，也不会自动开始工作。" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Process only the items explicitly selected in this preview. Later changes prevent overwriting. Historical tasks are preserved and work does not start automatically."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只处理当前预览明确选择的条目；有后续修改会拒绝覆盖。历史任务保留，也不会自动开始工作。"
          }
        }
      }
    },
