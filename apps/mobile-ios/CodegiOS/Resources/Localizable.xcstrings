            "state" : "translated",
            "value" : "Only interface preferences upload by default. Select complete configuration and secrets separately. Each item must still be selected on another host after download; nothing starts automatically."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
